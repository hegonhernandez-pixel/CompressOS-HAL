config BR2_PACKAGE_COMPRESSO_ZVGA
	bool "compresso zVGA Vulkan compression worker"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_VULKAN_HEADERS
	depends on BR2_PACKAGE_VULKAN_LOADER
	help
	  Experimental bounded C++17/Vulkan worker and precompiled SPIR-V shader.
	  Shader validators are host build dependencies. This processes explicit
	  user-space buffers only; it is not a kernel ZRAM/Zswap codec and does
	  not map arbitrary process memory.
