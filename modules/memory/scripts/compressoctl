#!/usr/bin/env bash
set -euo pipefail

BASE="/usr/libexec/compresso"

usage() {
  cat <<'EOF'
CompressOS-HAL control

Usage:
  compressoctl status
  compressoctl doctor
  compressoctl metrics
  compressoctl hardware
  compressoctl benchmark --profile PROFILE [--memory-mib N] [--hold-seconds N] [--output FILE]
  compressoctl profile list
  compressoctl profile show
  compressoctl profile set PROFILE
  compressoctl engine compress|decompress|status|serve [OPTIONS]
  compressoctl help

"hardware" reads host/GPU/Vulkan and active memory-layer information; it does not modify the system.
"profile set" only updates the persistent PROFILE key in /etc/compresso/memory.conf.
It does not apply a profile to the running kernel, change swap, or restart services.
EOF
}

command_name="${1:-help}"
if (($#)); then shift; fi

case "$command_name" in
  status)
    exec python3 "$BASE/supervisor.py" --json "$@"
    ;;
  doctor)
    exec python3 "$BASE/supervisor.py" "$@"
    ;;
  metrics)
    exec python3 "$BASE/metrics.py" --stdout "$@"
    ;;
  hardware)
    exec python3 "$BASE/hardware.py" "$@"
    ;;
  benchmark)
    exec python3 "$BASE/benchmark.py" "$@"
    ;;
  engine)
    exec compresso-engine "$@"
    ;;
  profile)
    exec python3 "$BASE/profilectl.py" --config /etc/compresso/memory.conf "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Comando desconocido: $command_name" >&2
    usage >&2
    exit 2
    ;;
esac
